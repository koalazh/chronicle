# -------------------------------
# Chronicle LLM
# -------------------------------
# Choose exactly one:
#   api_key - OpenAI-compatible endpoint + API key
#   oauth   - Hermes-managed OpenAI Codex OAuth
CHRONICLE_LLM_AUTH_MODE=api_key

# API-key mode
CHRONICLE_LLM_BASE_URL=https://your-provider.example/v1
CHRONICLE_LLM_API_KEY=
CHRONICLE_LLM_MODEL=
CHRONICLE_LLM_API_MODE=chat_completions
CHRONICLE_LLM_REASONING_EFFORT=
CHRONICLE_LLM_TIMEOUT=180

# OAuth mode example (replace the block above):
# CHRONICLE_LLM_AUTH_MODE=oauth
# CHRONICLE_LLM_MODEL=gpt-5.6-luna
# CHRONICLE_LLM_API_MODE=responses
# CHRONICLE_LLM_REASONING_EFFORT=max
# CHRONICLE_LLM_API_KEY=

# -------------------------------
# Hermes
# -------------------------------
CHRONICLE_HERMES_BASE_URL=http://127.0.0.1:8642
CHRONICLE_HERMES_HOME=./.chronicle/hermes-home
CHRONICLE_HERMES_BIN=hermes

# -------------------------------
# Chronicle
# -------------------------------
CHRONICLE_DATABASE_URL=sqlite:///./data/chronicle.db
CHRONICLE_HOST=127.0.0.1
CHRONICLE_PORT=8711
CHRONICLE_DEV=false
